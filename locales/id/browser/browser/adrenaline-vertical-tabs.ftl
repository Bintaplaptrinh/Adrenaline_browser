tabbrowser-unload-tab-button = 
    .tooltiptext =
        { $tabCount ->
            [one] Lepaskan dan pindah ke tab
           *[other] Lepaskan { $tabCount } tab dan pindah ke bawah
        }
tabbrowser-reset-pin-button = 
    .tooltiptext =
        { $tabCount ->
            [one] Reset dan sematkan tab
           *[other] Reset dan sematkan { $tabCount } tab
        }
adrenaline-tab-sublabel =
    { $tabSubtitle ->
        [adrenaline-default-pinned] Kembali ke URL Awal
        [adrenaline-default-pinned-cmd] Pisahkan dari tab tersemat
       *[other] { $tabSubtitle }
    }
